<Window x:Class="Energy.frmTaxes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Energy"
        mc:Ignorable="d"
        Title="Belastingen" Height="200" Width="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Belastingen" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="24"/>
        <Label Content="Energiebelasting per KWh:" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TxtEnergyTax" HorizontalAlignment="Left" Margin="180,15,0,0" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" LostFocus="txtBox_LostFocus"/>
        <Label Content="Vermindering per dag:" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" Margin="10,30,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TxtReduction" HorizontalAlignment="Left" Margin="180,35,0,0" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" LostFocus="txtBox_LostFocus"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Grid.Row="2">
            <Button Content="Annuleren" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Width="100" IsCancel="True" Click="ButtonCancel_Click"/>
            <Button Content="OK" HorizontalAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center" Width="100" IsDefault="True" Click="ButtonOK_Click"/>
        </StackPanel>
    </Grid>
</Window>
