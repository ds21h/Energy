<Page x:Class="Energy.pgeConnection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Energy"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="pgeConnection">
    <Page.Resources>
        <Style x:Key="lvStyle" TargetType="{x:Type ListView}">
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
            <Setter Property="ListView.ItemsSource" Value="{Binding}"/>
            <Setter Property="ListView.View">
                <Setter.Value>
                    <GridView>
                        <GridViewColumn Header="Aansluiting" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="tConnection" Text="{Binding xConnection, Mode=OneWay}" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="lstConnections" Margin="10,5,0,5" Style="{DynamicResource lvStyle}" SelectionMode="Extended" Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}" Grid.Column="0" SelectionChanged="lstProviders_SelectionChanged">
        </ListView>
        <Canvas Margin="50,10,0,0" Grid.Row="0" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Grid.Row="0" Content="Aansluiting" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top"/>
                <Label Grid.Column="0" Grid.Row="0" Content="Fasen:" HorizontalAlignment="Left" Margin="0,20,0,0" VerticalAlignment="Top"/>
                <RadioButton x:Name="rdoFasen1" Grid.Column="1" Grid.Row="0" Content="1" Margin="0,25,0,0"/>
                <RadioButton x:Name="rdoFasen3" Grid.Column="1" Grid.Row="0" Content="3" Margin="40,25,0,0" IsChecked="True"/>
                <Label Grid.Column="0" Grid.Row="0" Content="Vermogen:" HorizontalAlignment="Left" Margin="0,40,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtMax" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Margin="0,45,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" LostFocus="txtBox_LostFocus"/>
                <Label Grid.Column="0" Grid.Row="0" Content="Tarieven" HorizontalAlignment="Left" Margin="0,70,0,0" VerticalAlignment="Top"/>
                <Label Grid.Column="0" Grid.Row="0" Content="Per Jaar:" HorizontalAlignment="Left" Margin="0,90,0,0" VerticalAlignment="Top"/>
                <Label Grid.Column="0" Grid.Row="0" Content="Per Dag" HorizontalAlignment="Left" Margin="0,110,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtYear" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Margin="0,95,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" LostFocus="txtBox_LostFocus"/>
                <TextBox x:Name="txtDay" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Margin="0,115,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" LostFocus="txtBox_LostFocus"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Margin="0,30,0,0">
                    <Button x:Name="btnNew" Content="Nieuw" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Center" Width="75" Click="btnNew_Click"/>
                    <Button x:Name="btnOK" Content="Bewaren" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Center" Width="75" Click="btnOK_Click"/>
                    <Button x:Name="btnDelete" Content="Verwijderen" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Center" Width="75" Click="btnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Page>
