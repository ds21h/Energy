<Window x:Class="Energy.frmNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Energy"
        mc:Ignorable="d"
        Title="Nieuw Dossier" Height="200" Width="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="117*"/>
            <ColumnDefinition Width="58*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Nieuw Dossier" HorizontalAlignment="Left" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="24"/>
        <Label Content="Naam:" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" Margin="10,20,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TxtName" HorizontalAlignment="Left" Margin="55,25,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Grid.ColumnSpan="2"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Button Content="Annuleren" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Width="100" IsCancel="True" Click="ButtonCancel_Click"/>
            <Button Content="OK" HorizontalAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center" Width="100" IsDefault="True" Click="ButtonOK_Click"/>
        </StackPanel>
    </Grid>
</Window>
